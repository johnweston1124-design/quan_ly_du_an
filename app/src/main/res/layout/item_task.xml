<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="3dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/divider">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/txtTaskTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/txt_thiet_ke_giao_dien_l"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@color/text_primary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/txtDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/txt_thiet_ke_giao_dien_a"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:maxLines="2"
            android:ellipsize="end"
            app:layout_constraintTop_toBottomOf="@id/txtTaskTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <ImageView
            android:id="@+id/imgDeadline"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginTop="14dp"
            android:src="@android:drawable/ic_menu_today"
            android:contentDescription="Deadline"
            app:layout_constraintTop_toBottomOf="@id/txtDescription"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/txtDeadline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="20/07/2026"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:layout_marginStart="6dp"
            app:layout_constraintStart_toEndOf="@id/imgDeadline"
            app:layout_constraintTop_toTopOf="@id/imgDeadline"/>

        <ImageView
            android:id="@+id/imgUser"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="20dp"
            android:src="@android:drawable/ic_menu_myplaces"
            android:contentDescription="Người thực hiện"
            app:layout_constraintStart_toEndOf="@id/txtDeadline"
            app:layout_constraintTop_toTopOf="@id/imgDeadline"/>

        <TextView
            android:id="@+id/txtUser"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/txt_nguyen_van_a"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:layout_marginStart="6dp"
            app:layout_constraintStart_toEndOf="@id/imgUser"
            app:layout_constraintTop_toTopOf="@id/imgUser"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/chipPriority"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/txt_cao"
            android:textColor="@android:color/white"
            app:chipBackgroundColor="@color/danger"
            app:layout_constraintTop_toBottomOf="@id/imgDeadline"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="16dp"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/chipStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/txt_ang_lam"
            android:textColor="@android:color/white"
            app:chipBackgroundColor="@color/warning"
            app:layout_constraintTop_toTopOf="@id/chipPriority"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
